@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" data-aos="fade-down">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div class="flex-grow-1">@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" data-aos="fade-down">
        <i class="fa-solid fa-circle-exclamation fs-5"></i>
        <div class="flex-grow-1">@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert" data-aos="fade-down">
        <i class="fa-solid fa-triangle-exclamation fs-5"></i>
        <div class="flex-grow-1">@TempData["Warning"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}