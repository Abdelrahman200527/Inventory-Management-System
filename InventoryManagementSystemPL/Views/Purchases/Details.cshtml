@model PurchaseResponseDto
@{
    ViewData["Title"] = "تفاصيل فاتورة شراء";
}

<!-- Page Header -->
<div class="page-header" data-aos="fade-down">
    <div class="page-header-content">
        <div class="page-title-group">
            <div class="page-icon" style="background: linear-gradient(135deg, var(--info), #4299e1); box-shadow: 0 8px 20px rgba(44, 82, 130, 0.3);">
                <i class="fa-solid fa-file-invoice"></i>
            </div>
            <div>
                <h1 class="page-title">فاتورة شراء #@Model.Id</h1>
                <p class="page-subtitle">
                    <i class="fa-regular fa-calendar"></i>
                    @Model.PurchaseDate.ToString("yyyy-MM-dd HH:mm")
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-light" onclick="window.print()">
                <i class="fa-solid fa-print"></i> طباعة
            </button>
            <a asp-action="Index" class="btn btn-light">
                <i class="fa-solid fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>
</div>

<!-- Invoice Info -->
<div class="row g-3 mb-4">
    <div class="col-md-6" data-aos="fade-up">
        <div class="mini-stat">
            <div class="stat-icon stat-info">
                <i class="fa-solid fa-truck"></i>
            </div>
            <div>
                <small class="text-muted d-block">المورد</small>
                <strong>@Model.SupplierName</strong>
            </div>
        </div>
    </div>

    <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
        <div class="mini-stat">
            <div class="stat-icon stat-gold">
                <i class="fa-solid fa-money-bill-wave"></i>
            </div>
            <div>
                <small class="text-muted d-block">إجمالي الفاتورة</small>
                <strong style="font-size: 1.3rem; color: var(--primary);">
                    @Model.TotalAmount.ToString("N2") ج.م
                </strong>
            </div>
        </div>
    </div>
</div>

<!-- Items Table -->
<div class="table-wrapper" data-aos="fade-up" data-aos-delay="200">
    <div class="table-header">
        <h5><i class="fa-solid fa-boxes-stacked" style="color: var(--primary);"></i> أصناف الفاتورة</h5>
        <span class="table-badge">@Model.Items.Count صنف</span>
    </div>

    <div class="table-responsive-wrapper custom-scrollbar">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>المنتج</th>
                    <th>الكمية</th>
                    <th>سعر التكلفة</th>
                    <th>الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="font-weight: 600;">@item.ProductName</td>
                            <td>
                                <span class="badge-soft badge-soft-info">
                                    @item.Quantity وحدة
                                </span>
                            </td>
                            <td>@item.UnitCost.ToString("N2") ج.م</td>
                            <td>
                                <strong style="color: var(--primary);">
                                    @item.LineTotal.ToString("N2") ج.م
                                </strong>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state">
                                <i class="fa-solid fa-box-open"></i>
                                <h5>لا توجد أصناف</h5>
                                <p>هذه الفاتورة فارغة</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>