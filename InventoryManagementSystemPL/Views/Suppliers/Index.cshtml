@model IEnumerable<SupplierResponseDto>
@{
    ViewData["Title"] = "الموردين";
    var suppliersList = Model.ToList();
}

<!-- Page Header -->
<div class="page-header" data-aos="fade-down">
    <div class="page-header-content">
        <div class="page-title-group">
            <div class="page-icon" style="background: linear-gradient(135deg, var(--info), #4299e1); box-shadow: 0 8px 20px rgba(44, 82, 130, 0.3);">
                <i class="fa-solid fa-truck"></i>
            </div>
            <div>
                <h1 class="page-title">دليل الموردين</h1>
                <p class="page-subtitle">
                    <i class="fa-solid fa-circle-info"></i>
                    إدارة بيانات الموردين والشركات
                </p>
            </div>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fa-solid fa-plus"></i> إضافة مورد جديد
        </a>
    </div>
</div>

<!-- Table -->
<div class="table-wrapper" data-aos="fade-up">
    <div class="table-header">
        <h5><i class="fa-solid fa-list" style="color: var(--info);"></i> قائمة الموردين</h5>
        <span class="table-badge">@Model.Count() مورد</span>
    </div>

    <div class="table-responsive-wrapper custom-scrollbar">
        <table class="table table-custom">
            <thead>
                <tr>
                    <th>اسم المورد</th>
                    <th>جهة الاتصال</th>
                    <th>الهاتف</th>
                    <th>البريد الإلكتروني</th>
                    <th>العنوان</th>
                    <th class="text-center">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td style="font-weight: 600;">@item.SupplierName</td>
                            <td>@(item.ContactName ?? "-")</td>
                            <td>
                                <span class="badge-soft badge-soft-success">
                                    <i class="fa-solid fa-phone"></i> @item.Phone
                                </span>
                            </td>
                            <td>
                                <span class="text-muted small">
                                    <i class="fa-solid fa-envelope me-1"></i> @item.Email
                                </span>
                            </td>
                            <td>@(item.Address ?? "-")</td>
                            <td class="text-center">
                                <div class="action-btns">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit" title="تعديل">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-view" title="عرض">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete" title="حذف">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="fa-solid fa-truck"></i>
                                <h5>لا يوجد موردين</h5>
                                <p>ابدأ بإضافة أول مورد للنظام</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>