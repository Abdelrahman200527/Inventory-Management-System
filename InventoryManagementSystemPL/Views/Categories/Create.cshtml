@model CategoryCreateDto
@{
    ViewData["Title"] = "إضافة قسم جديد";
}

<!-- Page Header -->
<div class="page-header" data-aos="fade-down">
    <div class="page-header-content">
        <div class="page-title-group">
            <div class="page-icon" style="background: linear-gradient(135deg, var(--gold), var(--gold-light)); box-shadow: 0 8px 20px rgba(184, 134, 11, 0.3);">
                <i class="fa-solid fa-plus"></i>
            </div>
            <div>
                <h1 class="page-title">إضافة قسم جديد</h1>
                <p class="page-subtitle">
                    <i class="fa-solid fa-circle-info"></i>
                    أدخل بيانات القسم لإضافته إلى النظام
                </p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-light">
            <i class="fa-solid fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card" data-aos="fade-up">
            <div class="form-card-header">
                <div class="page-icon" style="background: linear-gradient(135deg, var(--gold), var(--gold-light));">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <h4>بيانات القسم</h4>
                    <p>جميع الحقول المعلمة بـ <span class="text-danger">*</span> مطلوبة</p>
                </div>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="CategoryName" class="form-label">
                            اسم القسم <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CategoryName" class="form-control" placeholder="مثال: إلكترونيات، أغذية..." required />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label">
                            الوصف
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف مختصر للقسم (اختياري)"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 mt-4 pt-4" style="border-top: 1px solid var(--border-color);">
                    <a asp-action="Index" class="btn btn-light">
                        <i class="fa-solid fa-xmark"></i> إلغاء
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> حفظ القسم
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}