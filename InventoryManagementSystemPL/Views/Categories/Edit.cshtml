@model CategoryUpdateDto
@{
    ViewData["Title"] = "تعديل قسم";
}

<!-- Page Header -->
<div class="page-header" data-aos="fade-down">
    <div class="page-header-content">
        <div class="page-title-group">
            <div class="page-icon" style="background: linear-gradient(135deg, var(--warning), #d97706); box-shadow: 0 8px 20px rgba(245, 158, 11, 0.3);">
                <i class="fa-solid fa-pen"></i>
            </div>
            <div>
                <h1 class="page-title">تعديل بيانات القسم</h1>
                <p class="page-subtitle">
                    <i class="fa-solid fa-circle-info"></i>
                    قم بتحديث بيانات القسم
                </p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-light">
            <i class="fa-solid fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card" data-aos="fade-up">
            <div class="form-card-header">
                <div class="page-icon" style="background: linear-gradient(135deg, var(--warning), #d97706);">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <h4>تحديث بيانات القسم</h4>
                    <p>عدّل الحقول المطلوبة ثم اضغط حفظ</p>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-12">
                        <label asp-for="CategoryName" class="form-label">
                            اسم القسم <span class="text-danger">*</span>
                        </label>
                        <input asp-for="CategoryName" class="form-control" required />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Description" class="form-label">الوصف</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 mt-4 pt-4" style="border-top: 1px solid var(--border-color);">
                    <a asp-action="Index" class="btn btn-light">
                        <i class="fa-solid fa-xmark"></i> إلغاء
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk"></i> حفظ التعديلات
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}