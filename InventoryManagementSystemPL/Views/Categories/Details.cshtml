@model CategoryResponseDto
@{
    ViewData["Title"] = "تفاصيل القسم";
}

<!-- Page Header -->
<div class="page-header" data-aos="fade-down">
    <div class="page-header-content">
        <div class="page-title-group">
            <div class="page-icon" style="background: linear-gradient(135deg, var(--info), #4299e1); box-shadow: 0 8px 20px rgba(44, 82, 130, 0.3);">
                <i class="fa-solid fa-eye"></i>
            </div>
            <div>
                <h1 class="page-title">تفاصيل القسم</h1>
                <p class="page-subtitle">
                    <i class="fa-solid fa-tag"></i>
                    @Model.CategoryName
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="fa-solid fa-pen"></i> تعديل
            </a>
            <a asp-action="Index" class="btn btn-light">
                <i class="fa-solid fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="form-card" data-aos="fade-up">
            <div class="form-card-header">
                <div class="page-icon" style="background: linear-gradient(135deg, var(--gold), var(--gold-light));">
                    <i class="fa-solid fa-tag"></i>
                </div>
                <div>
                    <h4>@Model.CategoryName</h4>
                    <p>معلومات القسم الكاملة</p>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mini-stat">
                        <div class="stat-icon stat-gold">
                            <i class="fa-solid fa-hashtag"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">رقم القسم</small>
                            <strong>#@Model.Id</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mini-stat">
                        <div class="stat-icon stat-primary">
                            <i class="fa-solid fa-tag"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">اسم القسم</small>
                            <strong>@Model.CategoryName</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mini-stat">
                        <div class="stat-icon stat-success">
                            <i class="fa-solid fa-box"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">عدد المنتجات</small>
                            <strong style="color: var(--primary);">@Model.ProductCount منتج</strong>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mini-stat">
                        <div class="stat-icon stat-info">
                            <i class="fa-solid fa-circle-info"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block">الحالة</small>
                            @if (Model.ProductCount > 0)
                            {
                                <strong class="text-success">نشط</strong>
                            }
                            else
                            {
                                <strong class="text-muted">فارغ</strong>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="col-md-12">
                        <div class="mini-stat">
                            <div class="stat-icon stat-gold">
                                <i class="fa-solid fa-align-right"></i>
                            </div>
                            <div style="flex: 1;">
                                <small class="text-muted d-block">الوصف</small>
                                <strong style="font-weight: 500;">@Model.Description</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>